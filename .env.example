# PRAXIS frontend configuration.
# Copy this file to .env.local and replace the placeholders with your own
# Supabase project values. Never put a service-role key or database password
# in a VITE_* variable: Vite exposes those values to the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
